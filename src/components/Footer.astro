---
import { getEntry } from 'astro:content';

const footer = await getEntry('site', 'footer');
const year = new Date().getFullYear();
const f = footer?.data;

// Fallback values if the singleton isn't loaded.
const heading = f?.heading ?? 'Coach Nikki';
const lead = f?.lead ?? 'Strength & movement coaching for over 30s.';
const address = f?.address ?? 'Unit 3 / 60 Perry St, Matraville NSW 2036.';
const phone = f?.phone ?? '0403 122 669';
const email = f?.email ?? 'nikkir30030@gmail.com';
const linkGroups = f?.linkGroups ?? [];
const copyrightLine = (f?.copyrightLine ?? '© {year} Nikki Rubino. Coach Nikki is a sole trader business in Sydney, Australia.').replace('{year}', String(year));
const creditLine = f?.creditLine ?? 'Site by Richie. Strength is ageless.';
---

<footer class="wf-footer">
  <div class="grid">
    <div>
      <h4>{heading}</h4>
      <p style="color:#bdb6b3; font-size:14px; line-height:1.6;">
        {lead}<br />
        {address}
      </p>
      <p style="margin-top:14px; font-size:14px;">
        <a href={`tel:${phone.replace(/\s+/g, '')}`}>{phone}</a><br />
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    </div>
    {linkGroups.map((g) => (
      <div>
        <h4>{g.heading}</h4>
        <ul>
          {g.items.map((i) => (
            <li>
              <a href={i.href} target={i.external ? '_blank' : undefined} rel={i.external ? 'noopener' : undefined}>
                {i.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="legal">
    <span>{copyrightLine}</span>
    <span>{creditLine}</span>
  </div>
</footer>
