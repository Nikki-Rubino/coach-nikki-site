---
import { getEntry } from 'astro:content';

interface Props {
  active?: string;
}
const { active } = Astro.props;

// Header branding — content from src/content/site/branding.md.
// If logoImage is set, render it instead of the text-mark.
const branding = await getEntry('site', 'branding');
const logoImage = branding?.data?.logoImage;
const logoAlt = branding?.data?.logoAlt ?? 'Coach Nikki';
const siteName = branding?.data?.siteName ?? 'Coach Nikki';
const siteTagline = branding?.data?.siteTagline ?? 'Strength is ageless';

const links = [
  { href: '/sessions', label: 'Sessions', key: 'sessions' },
  { href: '/sassy-seniors', label: 'Sassy Seniors', key: 'sassy-seniors' },
  { href: '/animal-flow', label: 'Animal Flow', key: 'animal-flow' },
  { href: '/timetable', label: 'Timetable', key: 'timetable' },
  { href: '/pricing', label: 'Pricing', key: 'pricing' },
  { href: '/about', label: 'About', key: 'about' },
  { href: '/faq', label: 'FAQ', key: 'faq' },
  { href: '/blog', label: 'Blog', key: 'blog' },
  { href: '/contact', label: 'Contact', key: 'contact' },
];
---

<nav class="wf-nav" aria-label="Primary">
  <a href="/" class="logo">
    {logoImage ? (
      <img
        src={logoImage}
        alt={logoAlt}
        width="44"
        height="44"
        class="logo-img"
        style="width: 44px; height: 44px; object-fit: contain; display: block; border-radius: 8px;"
      />
    ) : (
      <span class="mark" aria-hidden="true"></span>
    )}
    <span>
      {siteName}
      <span class="sub">{siteTagline}</span>
    </span>
  </a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle-cb" hidden />
  <label for="nav-toggle" class="nav-toggle" aria-label="Toggle menu">
    <span></span>
    <span></span>
    <span></span>
  </label>
  <div class="links">
    {
      links.map((l) => (
        <a href={l.href} class={active === l.key ? 'active' : ''}>
          {l.label}
        </a>
      ))
    }
  </div>
  <a
    href="https://www.instagram.com/coach_nikkir/"
    class="ig-link"
    aria-label="Coach Nikki on Instagram"
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
    </svg>
  </a>
  <a href="/get-started" class="cta">Get started</a>
</nav>
