---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'get-started-thanks');
const hero = page?.data ?? {
  eyebrow: "You're in",
  heroHeadline: "I've got your details. GO YOU!",
  heroSubcopy:
    "I'll review what you've shared and reach out in your preferred channel within one business day.",
  primaryCtaLabel: 'See the timetable',
  primaryCtaHref: '/timetable',
  secondaryCtaLabel: 'Back to home',
  secondaryCtaHref: '/',
};

// Onboarding content — Page copy → 14 Thanks (intro screening) → ONBOARDING.
const onboarding = page?.data?.onboarding;
const closingParas = (onboarding?.closingBody ?? '')
  .split(/\n\s*\n/)
  .filter((p) => p.trim().length > 0);
---

<BaseLayout
  title={page?.data.seoTitle ?? 'Thanks — your intro screening is in'}
  description={page?.data.seoDescription}
  activeNav="get-started"
>
  <!-- HERO -->
  <section class="hero">
    <div>
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1 class="display">{hero.heroHeadline}</h1>
      <p class="lead">{hero.heroSubcopy}</p>
      <div style="margin-top: 28px;">
        <a class="btn-primary" href={hero.primaryCtaHref}>{hero.primaryCtaLabel}</a>
        <a class="btn-secondary" href={hero.secondaryCtaHref}>{hero.secondaryCtaLabel}</a>
      </div>
    </div>
    <div class="image">
      <span class="ph-label">Photo: warm studio detail, ready and waiting</span>
    </div>
  </section>

  <!-- WHAT HAPPENS NEXT -->
  <section style="background: #fff;">
    <div class="container narrow" style="text-align: center;">
      <span class="eyebrow">What happens next</span>
      <h2 class="section">Three quick things</h2>
      <div class="steps" style="margin-top: 40px;">
        <div class="step">
          <h3>I read your screening</h3>
          <p>Usually within a few hours. I'll plan our first session around what you've shared.</p>
        </div>
        <div class="step">
          <h3>I reach out</h3>
          <p>In your preferred channel. We confirm a time and lock in your payment via Square.</p>
        </div>
        <div class="step">
          <h3>You show up</h3>
          <p>Comfortable kit, water bottle, an open mind. The rest is on me.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- GROUND RULES — Page copy → 14 Thanks (intro screening) → ONBOARDING -->
  {onboarding?.rules && onboarding.rules.length > 0 && (
    <section>
      <div class="container narrow">
        {onboarding.eyebrow && <span class="eyebrow">{onboarding.eyebrow}</span>}
        {onboarding.heading && <h2 class="section">{onboarding.heading}</h2>}
        {onboarding.lead && <p class="lead muted">{onboarding.lead}</p>}
        <div class="policy-rows">
          {onboarding.rules.map((r) => (
            <div class="policy-row">
              <div class="policy-h">{r.label}</div>
              <p style="font-size: 14px; color: var(--ink); margin: 0;">{r.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CLOSING -->
  {(closingParas.length > 0 || onboarding?.quote) && (
    <section style="background: var(--teal-light);">
      <div class="container narrow" style="text-align: center;">
        {onboarding?.closingHeading && <h2 class="section">{onboarding.closingHeading}</h2>}
        {closingParas.map((p) => (
          <p class="lead" style="margin-top: 18px;">{p}</p>
        ))}
        {onboarding?.quote && (
          <blockquote class="onboarding-quote">
            "{onboarding.quote}"
            {onboarding.quoteCite && <cite>— {onboarding.quoteCite}</cite>}
          </blockquote>
        )}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .onboarding-quote {
    margin: 36px auto 0;
    max-width: 560px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.5;
    color: var(--black);
  }
  .onboarding-quote cite {
    display: block;
    margin-top: 12px;
    font-family: var(--font-body);
    font-weight: 400;
    font-style: normal;
    font-size: 14px;
    color: var(--ink);
  }
</style>
