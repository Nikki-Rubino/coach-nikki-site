---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'speaking');
const hero = page?.data ?? {
  eyebrow: '★ Fuel Woman of the Year 2025',
  heroHeadline: 'Speaking up for the ageing fitness community.',
  heroSubcopy:
    'I was named Fuel Woman of the Year 2025 for my advocacy work. Later that year I returned to the Fuel Summit to speak on how the industry should be coaching the 55-plus crew.',
  primaryCtaLabel: 'Watch the speech',
  primaryCtaHref: '#speech',
  secondaryCtaLabel: 'Read my piece',
  secondaryCtaHref: '#piece',
};

// Speaking blocks now live inside the page entry.
const fuelMeaning = page?.data?.fuelMeaning;
const speechIntro = page?.data?.speechIntro;
const speechPull = page?.data?.speechPull;
const passion = page?.data?.passion;
const elsewhere = page?.data?.elsewhere;
const podcasts = page?.data?.podcasts;
const finalCta = page?.data?.finalCta;

// "Press · further reading" — blog posts picked in the CMS (Page copy → 10 Speaking
// → ELSEWHERE → Blog posts to feature). Only published (non-draft) posts render;
// if none are published the freeform cards below are shown instead.
const allPosts = await getCollection('blog', (e) => !e.data.draft);
const pickedSlugs = elsewhere?.posts ?? [];
// Tolerant matching: the CMS relation widget can save the pick as the full
// filename slug, a date-less slug, or the post title depending on how the
// entry was created. Normalise both sides so any of those formats resolves.
const norm = (s: string) =>
  s
    .toLowerCase()
    .replace(/\.md$/, '')
    .replace(/^\d{4}-\d{2}-\d{2}-/, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
const elsewherePosts = [
  ...new Set(
    pickedSlugs
      .map(
        (slug) =>
          allPosts.find((p) => p.id === slug) ??
          allPosts.find(
            (p) => norm(p.id) === norm(slug) || norm(p.data.title) === norm(slug),
          ),
      )
      .filter((p) => p !== undefined),
  ),
];
const dateFmt = new Intl.DateTimeFormat('en-AU', { month: 'long', year: 'numeric' });

const ytId = page?.data?.youtubeVideoId;
const awardYtId = page?.data?.awardVideoId;
// Passion body is a multi-line string in YAML — render as paragraphs.
const passionParas = (passion?.body ?? '')
  .split(/\n\s*\n/)
  .filter((p) => p.trim().length > 0);
---

<BaseLayout
  title="Speaking — Coach Nikki, Fuel Woman of the Year 2025"
  description="Coach Nikki on stage at the Fuel Summit, talking about how the fitness industry should be coaching the over-55 crew. Plus press, podcasts and workshops."
  activeNav="speaking"
>
  <!-- HERO -->
  <section class="speaking-hero">
    <div class="grid">
      <div>
        <span class="award-tag">{hero.eyebrow}</span>
        <h1>{hero.heroHeadline}</h1>
        <p>{hero.heroSubcopy}</p>
        <div style="margin-top: 28px;">
          <a class="btn-primary" style="background: var(--orange); color: #fff !important;" href={hero.primaryCtaHref}>
            {hero.primaryCtaLabel}
          </a>
          <a class="btn-secondary" style="color: var(--ink) !important; border-color: var(--ink);" href={hero.secondaryCtaHref}>
            {hero.secondaryCtaLabel}
          </a>
        </div>
      </div>
      <div class="ph">
        {hero.heroImage ? (
          <img
            src={hero.heroImage}
            alt={hero.heroHeadline ?? 'Coach Nikki on stage at Fuel Summit'}
            loading="eager"
            fetchpriority="high"
            style="width: 100%; height: 100%; object-fit: cover; display: block;"
          />
        ) : (
          <span class="ph-label">Photo: Nikki on stage at Fuel Summit, mid-speech</span>
        )}
      </div>
    </div>
  </section>

  <!-- THE RECOGNITION — content from src/content/site/speaking-fuel-meaning.md -->
  {fuelMeaning && (
    <section>
      <div class="container">
        {fuelMeaning.eyebrow && <span class="eyebrow">{fuelMeaning.eyebrow}</span>}
        {fuelMeaning.heading && <h2 class="section">{fuelMeaning.heading}</h2>}
        {fuelMeaning.lead && <p class="lead">{fuelMeaning.lead}</p>}
        {fuelMeaning.closingLine && (
          <p class="lead" style="margin-top: 18px;">{fuelMeaning.closingLine}</p>
        )}
        {awardYtId && (
          <div class="video-embed" style="margin-top: 32px; max-width: 420px; margin-left: auto; margin-right: auto; aspect-ratio: 9 / 16;">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${awardYtId}?rel=0&modestbranding=1`}
              title="Nikki receiving the Fuel Woman of the Year award"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
              style="width: 100%; height: 100%;"
            ></iframe>
          </div>
        )}
        <div class="speaking-grid">
          <div class="ph">
            {fuelMeaning.image1 ? (
              <img src={fuelMeaning.image1} alt="Award moment" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
            ) : (
              <span class="ph-label">Award moment</span>
            )}
          </div>
          <div class="ph">
            {fuelMeaning.image2 ? (
              <img src={fuelMeaning.image2} alt="Group shot at summit" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
            ) : (
              <span class="ph-label">Group shot at summit</span>
            )}
          </div>
          <div class="ph">
            {fuelMeaning.image3 ? (
              <img src={fuelMeaning.image3} alt="Nikki with award" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
            ) : (
              <span class="ph-label">Nikki with award</span>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- THE SPEECH — header from src/content/site/speaking-speech-intro.md, video uses page's YouTube ID -->
  {speechIntro && (
    <section id="speech" style="background: #fff;">
      <div class="container">
        {speechIntro.eyebrow && <span class="eyebrow">{speechIntro.eyebrow}</span>}
        {speechIntro.heading && <h2 class="section">{speechIntro.heading}</h2>}
        {speechIntro.lead && <p class="lead muted">{speechIntro.lead}</p>}
        {ytId ? (
          <div class="video-embed" style="margin-top: 32px;">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${ytId}?rel=0&modestbranding=1`}
              title="Nikki's Fuel Summit speech"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        ) : (
          <div class="video-block" style="margin-top: 32px;">
            <div class="play">▶</div>
            <span class="ph-label">Add a YouTube video ID in the CMS (Page copy → 10 Speaking → YouTube video ID)</span>
          </div>
        )}
        {speechIntro.closingLine && (
          <p class="muted" style="margin-top: 16px; font-size: 14px; text-align: center;">
            {speechIntro.closingLine}
            {speechIntro.ctaLabel && (
              <> <a class="btn-secondary" href={speechIntro.ctaHref ?? '#piece'}>{speechIntro.ctaLabel}</a></>
            )}
          </p>
        )}
      </div>
    </section>
  )}

  <!-- SPEECH PULL QUOTE — content from src/content/site/speaking-speech-pull.md -->
  {speechPull?.pullQuote && (
    <section class="speech-pull">
      <blockquote>
        "{speechPull.pullQuote}"
        {speechPull.pullQuoteCite && <cite>{speechPull.pullQuoteCite}</cite>}
      </blockquote>
    </section>
  )}

  <!-- THE PIECE — body from src/content/site/speaking-passion.md -->
  {passion && (
    <section id="piece">
      <div class="container">
        {passion.eyebrow && <span class="eyebrow">{passion.eyebrow}</span>}
        {passion.heading && <h2 class="section">{passion.heading}</h2>}
        <div class="passion-block" style="margin-top: 36px;">
          <div class="ph">
            {passion.image ? (
              <img
                src={passion.image}
                alt="Portrait of Coach Nikki"
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover; display: block;"
              />
            ) : (
              <span class="ph-label">Portrait of Nikki</span>
            )}
          </div>
          <div>
            {passionParas.map((p) => <p>{p}</p>)}
            <div style="margin-top: 32px;">
              {passion.ctaLabel && (
                <a class="btn-primary" href={passion.ctaHref ?? '/get-started'}>{passion.ctaLabel}</a>
              )}
              {passion.ctaSecondaryLabel && (
                <a class="btn-secondary" href={passion.ctaSecondaryHref ?? '/sassy-seniors'}>{passion.ctaSecondaryLabel}</a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- PODCASTS — Page copy → 10 Speaking → Podcasts -->
  {podcasts?.items && podcasts.items.length > 0 && (
    <section id="podcasts" style="background: #fff;">
      <div class="container narrow">
        {podcasts.eyebrow && <span class="eyebrow">{podcasts.eyebrow}</span>}
        {podcasts.heading && <h2 class="section">{podcasts.heading}</h2>}
        {podcasts.lead && <p class="lead muted">{podcasts.lead}</p>}
        <div class="podcast-list">
          {podcasts.items.map((p) => (
            <div class="podcast-item">
              <iframe
                src={p.embedUrl}
                title={p.title}
                width="100%"
                height="152"
                frameborder="0"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"
                style="border-radius: 12px;"
              ></iframe>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- PRESS / FURTHER READING — content from src/content/site/speaking-elsewhere.md -->
  {elsewhere && (
    <section>
      <div class="container">
        {elsewhere.eyebrow && <span class="eyebrow">{elsewhere.eyebrow}</span>}
        {elsewhere.heading && <h2 class="section">{elsewhere.heading}</h2>}
        {elsewherePosts.length > 0 ? (
          <div class="blog-list">
            {elsewherePosts.map((p) => (
              <a class="post" href={`/blog/${p.id}`}>
                <div class="ph">
                  {p.data.image ? (
                    <img
                      src={p.data.image}
                      alt={p.data.title}
                      loading="lazy"
                      style="width: 100%; height: 100%; object-fit: cover; display: block;"
                    />
                  ) : (
                    <span class="ph-label">Post thumbnail</span>
                  )}
                </div>
                <div class="date">{dateFmt.format(p.data.date)}</div>
                <h3>{p.data.title}</h3>
                {p.data.excerpt && <p>{p.data.excerpt}</p>}
              </a>
            ))}
          </div>
        ) : elsewhere.cards && (
          <div class="blog-list">
            {elsewhere.cards.map((c) => (
              <a class="post">
                <div class="ph"><span class="ph-label">{c.label}</span></div>
                <div class="date">{c.icon}</div>
                <h3>{c.label}</h3>
                <p>{c.body}</p>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- FINAL CTA — content from src/content/site/speaking-final-cta.md -->
  {finalCta && (
    <section class="cta-strip">
      <div class="container narrow">
        {finalCta.heading && <h2>{finalCta.heading}</h2>}
        {finalCta.lead && <p>{finalCta.lead}</p>}
        {finalCta.ctaLabel && (
          <a class="btn-primary" href={finalCta.ctaHref ?? '/get-started'}>{finalCta.ctaLabel}</a>
        )}
        {finalCta.ctaSecondaryLabel && (
          <a class="btn-secondary" style="color: #fff !important; border-color: #fff; margin-left: 8px;" href={finalCta.ctaSecondaryHref ?? '/timetable'}>
            {finalCta.ctaSecondaryLabel}
          </a>
        )}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .podcast-list {
    display: grid;
    gap: 20px;
    margin-top: 28px;
  }
</style>
