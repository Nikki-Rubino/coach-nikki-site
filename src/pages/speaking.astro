---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'speaking');
const hero = page?.data ?? {
  eyebrow: '★ Fuel Woman of the Year 2025',
  heroHeadline: 'Speaking up for the ageing fitness community.',
  heroSubcopy:
    'I was named Fuel Woman of the Year 2025 for my advocacy work. Later that year I returned to the Fuel Summit to speak on how the industry should be coaching the 55-plus crew.',
  primaryCtaLabel: 'Watch the speech',
  primaryCtaHref: '#speech',
  secondaryCtaLabel: 'Read my piece',
  secondaryCtaHref: '#piece',
};

// CMS-editable speaking sections.
const fuelMeaning = await getEntry('site', 'speaking-fuel-meaning');
const speechIntro = await getEntry('site', 'speaking-speech-intro');
const speechPull = await getEntry('site', 'speaking-speech-pull');
const passion = await getEntry('site', 'speaking-passion');
const elsewhere = await getEntry('site', 'speaking-elsewhere');
const finalCta = await getEntry('site', 'speaking-final-cta');

const ytId = page?.data?.youtubeVideoId;
const passionBody = passion?.rendered?.html ?? '';
---

<BaseLayout
  title="Speaking — Coach Nikki, Fuel Woman of the Year 2025"
  description="Coach Nikki on stage at the Fuel Summit, talking about how the fitness industry should be coaching the over-55 crew. Plus press, podcasts and workshops."
  activeNav="speaking"
>
  <!-- HERO -->
  <section class="speaking-hero">
    <div class="grid">
      <div>
        <span class="award-tag">{hero.eyebrow}</span>
        <h1>{hero.heroHeadline}</h1>
        <p>{hero.heroSubcopy}</p>
        <div style="margin-top: 28px;">
          <a class="btn-primary" style="background: var(--orange); color: #fff !important;" href={hero.primaryCtaHref}>
            {hero.primaryCtaLabel}
          </a>
          <a class="btn-secondary" style="color: var(--ink) !important; border-color: var(--ink);" href={hero.secondaryCtaHref}>
            {hero.secondaryCtaLabel}
          </a>
        </div>
      </div>
      <div class="ph"><span class="ph-label">Photo: Nikki on stage at Fuel Summit, mid-speech</span></div>
    </div>
  </section>

  <!-- THE RECOGNITION — content from src/content/site/speaking-fuel-meaning.md -->
  {fuelMeaning && (
    <section>
      <div class="container">
        {fuelMeaning.data.eyebrow && <span class="eyebrow">{fuelMeaning.data.eyebrow}</span>}
        {fuelMeaning.data.heading && <h2 class="section">{fuelMeaning.data.heading}</h2>}
        {fuelMeaning.data.lead && <p class="lead">{fuelMeaning.data.lead}</p>}
        {fuelMeaning.data.closingLine && (
          <p class="lead" style="margin-top: 18px;">{fuelMeaning.data.closingLine}</p>
        )}
        <div class="speaking-grid">
          <div class="ph"><span class="ph-label">Award moment</span></div>
          <div class="ph"><span class="ph-label">Group shot at summit</span></div>
          <div class="ph"><span class="ph-label">Nikki with award</span></div>
        </div>
      </div>
    </section>
  )}

  <!-- THE SPEECH — header from src/content/site/speaking-speech-intro.md, video uses page's YouTube ID -->
  {speechIntro && (
    <section id="speech" style="background: #fff;">
      <div class="container">
        {speechIntro.data.eyebrow && <span class="eyebrow">{speechIntro.data.eyebrow}</span>}
        {speechIntro.data.heading && <h2 class="section">{speechIntro.data.heading}</h2>}
        {speechIntro.data.lead && <p class="lead muted">{speechIntro.data.lead}</p>}
        {ytId ? (
          <div class="video-embed" style="margin-top: 32px;">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${ytId}?rel=0&modestbranding=1`}
              title="Nikki's Fuel Summit speech"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        ) : (
          <div class="video-block" style="margin-top: 32px;">
            <div class="play">▶</div>
            <span class="ph-label">Add a YouTube video ID in the CMS (Page copy → 10 Speaking → YouTube video ID)</span>
          </div>
        )}
        {speechIntro.data.closingLine && (
          <p class="muted" style="margin-top: 16px; font-size: 14px; text-align: center;">
            {speechIntro.data.closingLine}
            {speechIntro.data.ctaLabel && (
              <> <a class="btn-secondary" href={speechIntro.data.ctaHref ?? '#piece'}>{speechIntro.data.ctaLabel}</a></>
            )}
          </p>
        )}
      </div>
    </section>
  )}

  <!-- SPEECH PULL QUOTE — content from src/content/site/speaking-speech-pull.md -->
  {speechPull?.data.pullQuote && (
    <section class="speech-pull">
      <blockquote>
        "{speechPull.data.pullQuote}"
        {speechPull.data.pullQuoteCite && <cite>{speechPull.data.pullQuoteCite}</cite>}
      </blockquote>
    </section>
  )}

  <!-- THE PIECE — body from src/content/site/speaking-passion.md -->
  {passion && (
    <section id="piece">
      <div class="container">
        {passion.data.eyebrow && <span class="eyebrow">{passion.data.eyebrow}</span>}
        {passion.data.heading && <h2 class="section">{passion.data.heading}</h2>}
        <div class="passion-block" style="margin-top: 36px;">
          <div class="ph"><span class="ph-label">Portrait of Nikki</span></div>
          <div>
            <div set:html={passionBody} />
            <div style="margin-top: 32px;">
              {passion.data.ctaLabel && (
                <a class="btn-primary" href={passion.data.ctaHref ?? '/get-started'}>{passion.data.ctaLabel}</a>
              )}
              {passion.data.ctaSecondaryLabel && (
                <a class="btn-secondary" href={passion.data.ctaSecondaryHref ?? '/sassy-seniors'}>{passion.data.ctaSecondaryLabel}</a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- PRESS / FURTHER READING — content from src/content/site/speaking-elsewhere.md -->
  {elsewhere && (
    <section style="background: #fff;">
      <div class="container">
        {elsewhere.data.eyebrow && <span class="eyebrow">{elsewhere.data.eyebrow}</span>}
        {elsewhere.data.heading && <h2 class="section">{elsewhere.data.heading}</h2>}
        {elsewhere.data.cards && (
          <div class="blog-list">
            {elsewhere.data.cards.map((c) => (
              <a class="post">
                <div class="ph"><span class="ph-label">{c.label}</span></div>
                <div class="date">{c.icon}</div>
                <h3>{c.label}</h3>
                <p>{c.body}</p>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- FINAL CTA — content from src/content/site/speaking-final-cta.md -->
  {finalCta && (
    <section class="cta-strip">
      <div class="container narrow">
        {finalCta.data.heading && <h2>{finalCta.data.heading}</h2>}
        {finalCta.data.lead && <p>{finalCta.data.lead}</p>}
        {finalCta.data.ctaLabel && (
          <a class="btn-primary" href={finalCta.data.ctaHref ?? '/get-started'}>{finalCta.data.ctaLabel}</a>
        )}
        {finalCta.data.ctaSecondaryLabel && (
          <a class="btn-secondary" style="color: #fff !important; border-color: #fff; margin-left: 8px;" href={finalCta.data.ctaSecondaryHref ?? '/timetable'}>
            {finalCta.data.ctaSecondaryLabel}
          </a>
        )}
      </div>
    </section>
  )}
</BaseLayout>
