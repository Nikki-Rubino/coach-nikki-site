---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionsArc from '../components/SessionsArc.astro';

const page = await getEntry('pages', 'sassy-seniors');
const hero = page?.data ?? {
  eyebrow: 'Sassy Seniors · Strong & Sassy Classics',
  heroHeadline: 'Strength training that meets you where you are.',
  heroSubcopy:
    'For the 55+ crew who want to keep doing the things they love. Up to 6 in a session. Real strength work. Music from the good years.',
  primaryCtaLabel: 'Book your intro',
  primaryCtaHref: '/get-started',
  secondaryCtaLabel: 'See the timetable',
  secondaryCtaHref: '/timetable',
};

const sassyFaqs = (await getCollection('faqs', (e) => e.data.category === 'Sessions'))
  .sort((a, b) => a.data.order - b.data.order);

// FUEL band — shared content (also used on /about). Edit in CMS under Shared content.
const fuel = await getEntry('site', 'fuel-band');

// Page-specific blocks now live inside the page entry.
const ifFamiliar = page?.data?.ifFamiliar;
const realStrength = page?.data?.realStrength;
const format = page?.data?.format;
const finalCta = page?.data?.finalCta;

// Optional video block — only renders when youtubeVideoId is set in CMS.
// The primary clip is vertical (9:16); landscapeVideoId adds an optional 16:9 companion.
const ytId = page?.data?.youtubeVideoId;
const ytLandscapeId = page?.data?.landscapeVideoId;

// Three photos under the video. Edit in CMS: Page copy → 03 Sassy Seniors → Video photos.
const videoPhotos = page?.data?.videoPhotos;

// Inna testimonial — first featured testimonial tagged "Sassy Seniors" if present.
const featuredTestimonials = await getCollection('testimonials', (e) => e.data.featured);
const innaTestimonial =
  featuredTestimonials.find((t) => t.data.program === 'Sassy Seniors') ?? featuredTestimonials[0];
---

<BaseLayout
  title="Sassy Seniors — strength training for over 55s in Matraville"
  description="Strong, social strength training for the 55+ crew in Matraville. Semi-private sessions, classic music, real lifts. Coach Nikki — Fuel Woman of the Year 2025."
  activeNav="sassy-seniors"
>
  <!-- HERO -->
  <section class="hero">
    <div>
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1 class="display">{hero.heroHeadline}</h1>
      <p class="lead">{hero.heroSubcopy}</p>
      <div style="margin-top: 28px;">
        <a class="btn-primary" href={hero.primaryCtaHref}>{hero.primaryCtaLabel}</a>
        <a class="btn-secondary" href={hero.secondaryCtaHref}>{hero.secondaryCtaLabel}</a>
      </div>
    </div>
    <div class="image">
      {hero.heroImage ? (
        <img
          src={hero.heroImage}
          alt={hero.heroHeadline ?? 'Sassy Seniors'}
          loading="eager"
          fetchpriority="high"
          style="width: 100%; height: 100%; object-fit: cover; display: block;"
        />
      ) : (
        <span class="ph-label">Photo: senior client mid-strength move, glow lights, real smile</span>
      )}
    </div>
  </section>

  <!-- FUEL BAND — content from src/content/site/fuel-band.md -->
  {fuel && (
    <section class="fuel-band">
      <div class="container">
        <div class="grid">
          <div class="ph">
            {fuel.data.image ? (
              <img
                src={fuel.data.image}
                alt="Nikki on stage at the Fuel summit"
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover; display: block;"
              />
            ) : (
              <span class="ph-label">Photo: Nikki on stage at the Fuel summit</span>
            )}
          </div>
          <div>
            {fuel.data.awardTagText && <span class="award-tag">{fuel.data.awardTagText}</span>}
            {fuel.data.heading && <h2>{fuel.data.heading}</h2>}
            <div class="fuel-body" set:html={fuel.rendered?.html ?? ''} />
            {fuel.data.pullQuote && (
              <blockquote>
                "{fuel.data.pullQuote}"
                {fuel.data.pullQuoteCite && <cite>{fuel.data.pullQuoteCite}</cite>}
              </blockquote>
            )}
            {fuel.data.ctaLabel && (
              <a class="btn-primary" href={fuel.data.ctaHref ?? '/speaking'}>{fuel.data.ctaLabel}</a>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- OPTIONAL VIDEO — renders only if youtubeVideoId is set on the page in CMS.
       Primary clip is vertical (9:16); landscapeVideoId adds a 16:9 companion below. -->
  {ytId && (
    <section style="background: #fff;">
      <div class="container narrow">
        <span class="eyebrow">See it in action</span>
        <h2 class="section">A look inside a session</h2>
        <div class="video-pair">
          <div class="video-embed portrait">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${ytId}?rel=0&modestbranding=1`}
              title="A session with the Sassy crew"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          {ytLandscapeId && (
            <div class="video-embed">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${ytLandscapeId}?rel=0&modestbranding=1`}
                title="A session with the Sassy crew"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- THREE PHOTOS UNDER THE VIDEO — Page copy → 03 Sassy Seniors → Video photos -->
  <section style="background: #fff; padding-top: 0;">
    <div class="container">
      <div class="speaking-grid">
        <div class="ph">
          {videoPhotos?.image1 ? (
            <img src={videoPhotos.image1} alt="Sassy Seniors session" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
          ) : (
            <span class="ph-label">Photo 1: Sassy crew in session</span>
          )}
        </div>
        <div class="ph">
          {videoPhotos?.image2 ? (
            <img src={videoPhotos.image2} alt="Sassy Seniors session" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
          ) : (
            <span class="ph-label">Photo 2: a real smile mid-lift</span>
          )}
        </div>
        <div class="ph">
          {videoPhotos?.image3 ? (
            <img src={videoPhotos.image3} alt="Sassy Seniors session" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
          ) : (
            <span class="ph-label">Photo 3: the crew, post-session</span>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- IF THIS SOUNDS FAMILIAR — content from src/content/site/sassy-if-familiar.md -->
  {ifFamiliar && (
    <section class="if-this-sounds">
      <div class="container">
        {ifFamiliar.eyebrow && <span class="eyebrow">{ifFamiliar.eyebrow}</span>}
        {ifFamiliar.heading && <h2 class="section">{ifFamiliar.heading}</h2>}
        <div class="ifsounds">
          {ifFamiliar.bullets && ifFamiliar.bullets.length > 0 && (
            <ul class="ifsounds-list">
              {ifFamiliar.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )}
          {ifFamiliar.closingLine && (
            <p class="closing-line">{ifFamiliar.closingLine}</p>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- WHAT YOU'LL ACTUALLY DO — content from src/content/site/sassy-real-strength.md -->
  {realStrength && (
    <section style="background:#fff;">
      <div class="container">
        <div class="what-youll-do">
          <div class="ph">
            {realStrength.image ? (
              <img
                src={realStrength.image}
                alt="Senior client mid-deadlift, smiling"
                loading="lazy"
                style="width: 100%; height: 100%; object-fit: cover; display: block;"
              />
            ) : (
              <span class="ph-label">Photo: senior client mid-deadlift, smiling</span>
            )}
          </div>
          <div>
            {realStrength.eyebrow && <span class="eyebrow">{realStrength.eyebrow}</span>}
            {realStrength.heading && <h2 class="section">{realStrength.heading}</h2>}
            {realStrength.lead && <p class="lead">{realStrength.lead}</p>}
            {realStrength.bullets && realStrength.bullets.length > 0 && (
              <ul>
                {realStrength.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
            {realStrength.closingLine && (
              <p style="margin-top: 20px; font-size: 17px;">{realStrength.closingLine}</p>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- THE FORMAT — content from src/content/site/sassy-format.md -->
  {format && (
    <section>
      <div class="container">
        {format.eyebrow && <span class="eyebrow">{format.eyebrow}</span>}
        {format.heading && <h2 class="section">{format.heading}</h2>}
        {format.capacityGrid && (
          <div class="format-grid">
            {format.capacityGrid.map((c) => (
              <div class="format-card">
                <div class="num">{c.number}</div>
                <div class="lbl">{c.label}</div>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- HOW WE START — shared steps + CTA (Shared content); header per-page from sassy-seniors.md → arc -->
  <SessionsArc background="var(--teal-light)" eyebrow={page?.data?.arc?.eyebrow} heading={page?.data?.arc?.heading} lead={page?.data?.arc?.lead} />

  <!-- TYPICAL WEEK -->
  <section style="background:#fff;">
    <div class="container">
      <span class="eyebrow">A typical week</span>
      <h2 class="section">When the Sassy crew meets</h2>
      <div class="typical-week">
        <div></div>
        <div class="day-h">Tuesday</div>
        <div class="day-h">Wednesday</div>
        <div class="day-h">Thursday</div>
        <div class="day-h">Friday</div>
        <div class="day-h">Saturday</div>
        <div class="cell time-h">11:00 AM</div>
        <div class="cell session">Strong &amp; Sassy</div>
        <div class="cell session">Strong &amp; Sassy</div>
        <div class="cell session">Strong &amp; Sassy</div>
        <div class="cell session">Strong &amp; Sassy</div>
        <div class="cell empty">·</div>
      </div>
      <p class="muted" style="margin-top: 20px; font-size: 14px;">
        Weekly unlimited gives you all four sessions. Times confirmed at intro.
      </p>
    </div>
  </section>

  <!-- FEATURED TESTIMONIAL — pulled from CMS testimonials collection, avatar rendered if set -->
  {innaTestimonial && (
    <section style="background: var(--teal); color: #fff;">
      <div class="container narrow" style="text-align: center;">
        <div style="display: flex; flex-direction: column; align-items: center; gap: 24px;">
          {innaTestimonial.data.avatar ? (
            <img
              src={innaTestimonial.data.avatar}
              alt={innaTestimonial.data.name}
              width="100"
              height="100"
              style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 2px solid rgba(255,255,255,0.5);"
            />
          ) : (
            <div style="width: 100px; height: 100px; border-radius: 50%; background: rgba(255,255,255,0.2); flex-shrink: 0;"></div>
          )}
          <blockquote style="font-size: 26px; font-style: italic; line-height: 1.4; font-weight: 500; font-family: var(--font-head);">
            "{innaTestimonial.data.quote}"
          </blockquote>
          <cite style="font-size: 16px; opacity: 0.85; font-style: normal;">
            {innaTestimonial.data.name}{innaTestimonial.data.role ? ` · ${innaTestimonial.data.role}` : ''}
          </cite>
        </div>
      </div>
    </section>
  )}

  <!-- FAQS -->
  {sassyFaqs.length > 0 && (
    <section>
      <div class="container narrow">
        <span class="eyebrow">The questions I get asked</span>
        <h2 class="section">Honest answers</h2>
        <div class="faq">
          {sassyFaqs.map((f) => (
            <details class="faq-item">
              <summary>{f.data.question}</summary>
              <div class="faq-body" set:html={f.rendered?.html ?? ''} />
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FINAL CTA — content from src/content/site/sassy-final-cta.md -->
  {finalCta && (
    <section class="cta-strip">
      <div class="container narrow">
        {finalCta.heading && <h2>{finalCta.heading}</h2>}
        {finalCta.lead && <p>{finalCta.lead}</p>}
        {finalCta.ctaLabel && (
          <a class="btn-primary" href={finalCta.ctaHref ?? '/get-started'}>{finalCta.ctaLabel}</a>
        )}
        {finalCta.ctaSecondaryLabel && (
          <a class="btn-secondary" style="color: #fff !important; border-color: #fff; margin-left: 8px;" href={finalCta.ctaSecondaryHref ?? '/contact'}>
            {finalCta.ctaSecondaryLabel}
          </a>
        )}
      </div>
    </section>
  )}
</BaseLayout>
