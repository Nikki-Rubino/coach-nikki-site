---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'sassy-seniors');
const hero = page?.data ?? {
  eyebrow: 'Sassy Seniors · Strong & Sassy Classics',
  heroHeadline: 'Strength training that meets you where you are.',
  heroSubcopy:
    'For the 55+ crew who want to keep doing the things they love. Up to 6 in a session. Real strength work. Music from the good years.',
  primaryCtaLabel: 'Book your intro',
  primaryCtaHref: '/get-started',
  secondaryCtaLabel: 'See the timetable',
  secondaryCtaHref: '/timetable',
};

const sassyFaqs = (await getCollection('faqs', (e) => e.data.category === 'Sessions'))
  .sort((a, b) => a.data.order - b.data.order);

// FUEL band content — singleton, shared with /about. Edit in CMS under Site → FUEL Woman of the Year band.
const fuel = await getEntry('site', 'fuel-band');

// Two CMS-editable Sassy blocks: "If this sounds familiar" bullets + "Real strength training" body.
const ifFamiliar = await getEntry('site', 'sassy-if-familiar');
const realStrength = await getEntry('site', 'sassy-real-strength');
const format = await getEntry('site', 'sassy-format');
const finalCta = await getEntry('site', 'sassy-final-cta');

// Inna testimonial — first featured testimonial tagged "Sassy Seniors" if present.
const featuredTestimonials = await getCollection('testimonials', (e) => e.data.featured);
const innaTestimonial =
  featuredTestimonials.find((t) => t.data.program === 'Sassy Seniors') ?? featuredTestimonials[0];
---

<BaseLayout
  title="Sassy Seniors — strength training for over 55s in Matraville"
  description="Strong, social strength training for the 55+ crew in Matraville. Semi-private sessions, classic music, real lifts. Coach Nikki — Fuel Woman of the Year 2025."
  activeNav="sassy-seniors"
>
  <!-- HERO -->
  <section class="hero">
    <div>
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1 class="display">{hero.heroHeadline}</h1>
      <p class="lead">{hero.heroSubcopy}</p>
      <div style="margin-top: 28px;">
        <a class="btn-primary" href={hero.primaryCtaHref}>{hero.primaryCtaLabel}</a>
        <a class="btn-secondary" href={hero.secondaryCtaHref}>{hero.secondaryCtaLabel}</a>
      </div>
    </div>
    <div class="image">
      <span class="ph-label">Photo: senior client mid-strength move, glow lights, real smile</span>
    </div>
  </section>

  <!-- FUEL BAND — content from src/content/site/fuel-band.md -->
  {fuel && (
    <section class="fuel-band">
      <div class="container">
        <div class="grid">
          <div class="ph"><span class="ph-label">Photo: Nikki on stage at the Fuel summit</span></div>
          <div>
            {fuel.data.awardTagText && <span class="award-tag">{fuel.data.awardTagText}</span>}
            {fuel.data.heading && <h2>{fuel.data.heading}</h2>}
            <div class="fuel-body" set:html={fuel.rendered?.html ?? ''} />
            {fuel.data.pullQuote && (
              <blockquote>
                "{fuel.data.pullQuote}"
                {fuel.data.pullQuoteCite && <cite>{fuel.data.pullQuoteCite}</cite>}
              </blockquote>
            )}
            {fuel.data.ctaLabel && (
              <a class="btn-primary" href={fuel.data.ctaHref ?? '/speaking'}>{fuel.data.ctaLabel}</a>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- IF THIS SOUNDS FAMILIAR — content from src/content/site/sassy-if-familiar.md -->
  {ifFamiliar && (
    <section class="if-this-sounds">
      <div class="container">
        {ifFamiliar.data.eyebrow && <span class="eyebrow">{ifFamiliar.data.eyebrow}</span>}
        {ifFamiliar.data.heading && <h2 class="section">{ifFamiliar.data.heading}</h2>}
        <div class="ifsounds">
          {ifFamiliar.data.bullets && ifFamiliar.data.bullets.length > 0 && (
            <ul class="ifsounds-list">
              {ifFamiliar.data.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )}
          {ifFamiliar.data.closingLine && (
            <p class="closing-line">{ifFamiliar.data.closingLine}</p>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- WHAT YOU'LL ACTUALLY DO — content from src/content/site/sassy-real-strength.md -->
  {realStrength && (
    <section style="background:#fff;">
      <div class="container">
        <div class="what-youll-do">
          <div class="ph"><span class="ph-label">Photo: senior client mid-deadlift, smiling</span></div>
          <div>
            {realStrength.data.eyebrow && <span class="eyebrow">{realStrength.data.eyebrow}</span>}
            {realStrength.data.heading && <h2 class="section">{realStrength.data.heading}</h2>}
            {realStrength.data.lead && <p class="lead">{realStrength.data.lead}</p>}
            {realStrength.data.bullets && realStrength.data.bullets.length > 0 && (
              <ul>
                {realStrength.data.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
            {realStrength.data.closingLine && (
              <p style="margin-top: 20px; font-size: 17px;">{realStrength.data.closingLine}</p>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- THE FORMAT — content from src/content/site/sassy-format.md -->
  {format && (
    <section>
      <div class="container">
        {format.data.eyebrow && <span class="eyebrow">{format.data.eyebrow}</span>}
        {format.data.heading && <h2 class="section">{format.data.heading}</h2>}
        {format.data.capacityGrid && (
          <div class="format-grid">
            {format.data.capacityGrid.map((c) => (
              <div class="format-card">
                <div class="num">{c.number}</div>
                <div class="lbl">{c.label}</div>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- HOW WE START -->
  <section style="background: var(--teal-light);">
    <div class="container">
      <span class="eyebrow">How we start</span>
      <h2 class="section">Three sessions, then you're in</h2>
      <p class="lead muted">
        Every new client begins with three private sessions. I'll assess where you are,
        build your foundations, and then welcome you into the Classics Squad.
      </p>
      <div class="steps">
        <div class="step">
          <h3>Joint assessment</h3>
          <p>Gentle, methodical. We find what your body needs and what to avoid.</p>
        </div>
        <div class="step">
          <h3>Strength foundations</h3>
          <p>I'll teach you how to lift safely. Squat, hinge, push, pull.</p>
        </div>
        <div class="step">
          <h3>Movement foundations</h3>
          <p>Some ground-based work too. I'll show you, you'll surprise yourself.</p>
        </div>
      </div>
      <div class="intro-cta">
        <div>
          <h3>The intro is $399 upfront, or $450 over three weeks.</h3>
          <p>Three private sessions with me, then you join the Sassy Seniors crew.</p>
        </div>
        <a class="btn-primary" href="/get-started">Book your intro</a>
      </div>
    </div>
  </section>

  <!-- TYPICAL WEEK -->
  <section style="background:#fff;">
    <div class="container">
      <span class="eyebrow">A typical week</span>
      <h2 class="section">When the Sassy crew meets</h2>
      <div class="typical-week">
        <div></div>
        <div class="day-h">Tuesday</div>
        <div class="day-h">Wednesday</div>
        <div class="day-h">Thursday</div>
        <div class="day-h">Friday</div>
        <div class="day-h">Saturday</div>
        <div class="cell time-h">11:00 AM</div>
        <div class="cell session">Strong &amp; Sassy</div>
        <div class="cell session">Strong &amp; Sassy</div>
        <div class="cell session">Strong &amp; Sassy</div>
        <div class="cell session">Strong &amp; Sassy</div>
        <div class="cell empty">·</div>
      </div>
      <p class="muted" style="margin-top: 20px; font-size: 14px;">
        Weekly unlimited gives you all four sessions. Times confirmed at intro.
      </p>
    </div>
  </section>

  <!-- FEATURED TESTIMONIAL — pulled from CMS testimonials collection, avatar rendered if set -->
  {innaTestimonial && (
    <section style="background: var(--teal); color: #fff;">
      <div class="container narrow" style="text-align: center;">
        <div style="display: flex; flex-direction: column; align-items: center; gap: 24px;">
          {innaTestimonial.data.avatar ? (
            <img
              src={innaTestimonial.data.avatar}
              alt={innaTestimonial.data.name}
              width="100"
              height="100"
              style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 2px solid rgba(255,255,255,0.5);"
            />
          ) : (
            <div style="width: 100px; height: 100px; border-radius: 50%; background: rgba(255,255,255,0.2); flex-shrink: 0;"></div>
          )}
          <blockquote style="font-size: 26px; font-style: italic; line-height: 1.4; font-weight: 500; font-family: var(--font-head);">
            "{innaTestimonial.data.quote}"
          </blockquote>
          <cite style="font-size: 16px; opacity: 0.85; font-style: normal;">
            {innaTestimonial.data.name}{innaTestimonial.data.role ? ` · ${innaTestimonial.data.role}` : ''}
          </cite>
        </div>
      </div>
    </section>
  )}

  <!-- FAQS -->
  {sassyFaqs.length > 0 && (
    <section>
      <div class="container narrow">
        <span class="eyebrow">The questions I get asked</span>
        <h2 class="section">Honest answers</h2>
        <div class="faq">
          {sassyFaqs.map((f) => (
            <details class="faq-item">
              <summary>{f.data.question}</summary>
              <div class="faq-body" set:html={f.rendered?.html ?? ''} />
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FINAL CTA — content from src/content/site/sassy-final-cta.md -->
  {finalCta && (
    <section class="cta-strip">
      <div class="container narrow">
        {finalCta.data.heading && <h2>{finalCta.data.heading}</h2>}
        {finalCta.data.lead && <p>{finalCta.data.lead}</p>}
        {finalCta.data.ctaLabel && (
          <a class="btn-primary" href={finalCta.data.ctaHref ?? '/get-started'}>{finalCta.data.ctaLabel}</a>
        )}
        {finalCta.data.ctaSecondaryLabel && (
          <a class="btn-secondary" style="color: #fff !important; border-color: #fff; margin-left: 8px;" href={finalCta.data.ctaSecondaryHref ?? '/contact'}>
            {finalCta.data.ctaSecondaryLabel}
          </a>
        )}
      </div>
    </section>
  )}
</BaseLayout>
