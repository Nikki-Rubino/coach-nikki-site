---
import CampaignLayout from '../layouts/CampaignLayout.astro';
---

<CampaignLayout
  title="You're booked in — Animal Flow | Coach Nikki"
  description="Thanks for booking your free Animal Flow class."
  conversion={true}
>
  <section class="hero" style="grid-template-columns: 1fr; text-align: center;">
    <div>
      <span class="eyebrow">All done</span>
      <h1 class="display">You're in. See you on the floor.</h1>
      <p class="lead" style="margin: 0 auto;">
        Thanks for booking your free Animal Flow class. Nikki will be in touch to confirm your spot
        and the session that suits — usually within a business day. No equipment needed: just bring water,
        comfy gear, and bare feet.
      </p>
      <div style="margin-top: 28px;">
        <a class="btn-primary" href="https://www.instagram.com/coach_nikkir/" target="_blank" rel="noopener noreferrer">Follow along on Instagram</a>
        <a class="btn-secondary" href="tel:0403122669">Call Nikki: 0403 122 669</a>
      </div>
    </div>
  </section>
</CampaignLayout>
