---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionsArc from '../components/SessionsArc.astro';

const page = await getEntry('pages', 'sessions');
const hero = page?.data ?? {
  eyebrow: "What's on offer",
  heroHeadline: 'Sessions for every body.',
  heroSubcopy:
    '1:1, semi-private, classics, Animal Flow, breath and mobility. Pick what fits this week. Mix what fits next.',
  primaryCtaLabel: 'Book your intro',
  primaryCtaHref: '/get-started',
  secondaryCtaLabel: 'See the timetable',
  secondaryCtaHref: '/timetable',
};

const allSessions = (await getCollection('sessions')).sort(
  (a, b) => a.data.order - b.data.order
);

const sessionFaqs = (await getCollection('faqs', (e) => e.data.category === 'Sessions'))
  .sort((a, b) => a.data.order - b.data.order);

// Shared CMS-editable singletons (used on multiple pages).
const introBand = await getEntry('site', 'intro-band');

// Sessions blocks now live inside the page entry.
const intro = page?.data?.intro;
const finalCta = page?.data?.finalCta;
---

<BaseLayout
  title={page?.data.seoTitle ?? 'Sessions — Coach Nikki Matraville'}
  description={page?.data.seoDescription}
  activeNav="sessions"
>
  <!-- HERO -->
  <section class="hero">
    <div>
      {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
      <h1 class="display">{hero.heroHeadline}</h1>
      <p class="lead">{hero.heroSubcopy}</p>
      <div style="margin-top: 28px;">
        {hero.primaryCtaLabel && (
          <a class="btn-primary" href={hero.primaryCtaHref}>{hero.primaryCtaLabel}</a>
        )}
        {hero.secondaryCtaLabel && (
          <a class="btn-secondary" href={hero.secondaryCtaHref}>{hero.secondaryCtaLabel}</a>
        )}
      </div>
    </div>
    <div class="image">
      {hero.heroImage ? (
        <img
          src={hero.heroImage}
          alt={hero.heroHeadline ?? 'Sessions'}
          loading="eager"
          fetchpriority="high"
          style="width: 100%; height: 100%; object-fit: cover; display: block;"
        />
      ) : (
        <span class="ph-label">Photo: studio collage — classics, AF, semi-private strength</span>
      )}
    </div>
  </section>

  <!-- INTRO REQUIREMENT BAND — content from src/content/site/intro-band.md -->
  {introBand && (
    <section style="background: var(--yellow-light); padding: 28px 32px;">
      <div class="container" style="display: flex; gap: 18px; align-items: center; flex-wrap: wrap; justify-content: center; text-align: center;">
        {introBand.data.bandTagText && (
          <span class="award-tag" style="background: var(--warm-dark);">{introBand.data.bandTagText}</span>
        )}
        {introBand.data.bandText && (
          <p style="font-size: 16px; max-width: 720px;">
            {introBand.data.bandText}
            {introBand.data.ctaLabel && introBand.data.ctaHref && (
              <> <a href={introBand.data.ctaHref} style="font-weight: 700;">{introBand.data.ctaLabel} →</a></>
            )}
          </p>
        )}
      </div>
    </section>
  )}

  <!-- FULL SESSIONS CATALOGUE — header from src/content/site/sessions-intro.md -->
  <section style="background: #fff;">
    <div class="container">
      {intro?.eyebrow && <span class="eyebrow">{intro.eyebrow}</span>}
      {intro?.heading && <h2 class="section">{intro.heading}</h2>}
      {intro?.lead && <p class="lead muted">{intro.lead}</p>}
      <div class="session-detail-grid">
        {allSessions.map((s) => (
          <article class="session-detail">
            <div class="ph">
              {s.data.image ? (
                <img
                  src={s.data.image}
                  alt={s.data.title}
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover; display: block;"
                />
              ) : (
                <span class="ph-label">{s.data.title}</span>
              )}
            </div>
            <div class="body">
              {s.data.tag && (
                <span class={`session-chip ${s.data.tagStyle}`}>{s.data.tag}</span>
              )}
              <h3>{s.data.title}</h3>
              <p class="summary">{s.data.summary}</p>
              <dl class="meta-rows">
                {s.data.capacity && (
                  <div><dt>Capacity</dt><dd>{s.data.capacity}</dd></div>
                )}
                {s.data.duration && (
                  <div><dt>Length</dt><dd>{s.data.duration}</dd></div>
                )}
                {s.data.bestFor && (
                  <div><dt>Best for</dt><dd>{s.data.bestFor}</dd></div>
                )}
                {s.data.price && (
                  <div><dt>Price</dt><dd class="price-cell">{s.data.price}</dd></div>
                )}
              </dl>
              <div class="session-actions">
                <a class="btn-secondary" href="/timetable">When it's on →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
      {intro?.closingLine && (
        <p class="muted" style="margin-top: 28px; text-align: center; font-size: 14px;">
          {intro.closingLine}
        </p>
      )}
    </div>
  </section>

  <!-- HOW IT WORKS — shared steps + CTA (Shared content); header per-page from sessions.md → arc -->
  <SessionsArc eyebrow={page?.data?.arc?.eyebrow} heading={page?.data?.arc?.heading} lead={page?.data?.arc?.lead} />

  <!-- FAQS -->
  {sessionFaqs.length > 0 && (
    <section style="background: #fff;">
      <div class="container narrow">
        <span class="eyebrow">Common questions</span>
        <h2 class="section">Before you book</h2>
        <div class="faq">
          {sessionFaqs.map((f) => (
            <details class="faq-item">
              <summary>{f.data.question}</summary>
              <div class="faq-body" set:html={f.rendered?.html ?? ''} />
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA — content from src/content/site/sessions-final-cta.md -->
  {finalCta && (
    <section class="cta-strip">
      <div class="container narrow">
        {finalCta.heading && <h2>{finalCta.heading}</h2>}
        {finalCta.lead && <p>{finalCta.lead}</p>}
        {finalCta.ctaLabel && (
          <a class="btn-primary" href={finalCta.ctaHref ?? '/get-started'}>{finalCta.ctaLabel}</a>
        )}
        {finalCta.ctaSecondaryLabel && (
          <a class="btn-secondary" style="color: #fff !important; border-color: #fff; margin-left: 8px;" href={finalCta.ctaSecondaryHref ?? '/pricing'}>
            {finalCta.ctaSecondaryLabel}
          </a>
        )}
      </div>
    </section>
  )}
</BaseLayout>
