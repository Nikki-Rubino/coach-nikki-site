---
import CampaignLayout from '../layouts/CampaignLayout.astro';
---

<CampaignLayout
  title="You're booked in — Strong & Sassy | Coach Nikki"
  description="Thanks for booking your free Strong & Sassy class."
  conversion={true}
>
  <section class="hero" style="grid-template-columns: 1fr; text-align: center;">
    <div>
      <span class="eyebrow">All done</span>
      <h1 class="display">You're in. Nice one.</h1>
      <p class="lead" style="margin: 0 auto;">
        Thanks for booking your free Strong &amp; Sassy class. Nikki will give you a call or text
        to confirm your spot and the day that suits — usually within a business day. Nothing to pay,
        nothing to bring but yourself and some water.
      </p>
      <div style="margin-top: 28px;">
        <a class="btn-primary" href="tel:0403122669">Call Nikki: 0403 122 669</a>
        <a class="btn-secondary" href="https://www.instagram.com/coach_nikkir/" target="_blank" rel="noopener noreferrer">See the crew on Instagram</a>
      </div>
    </div>
  </section>
</CampaignLayout>
