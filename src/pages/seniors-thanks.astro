---
import CampaignLayout from '../layouts/CampaignLayout.astro';
---

<CampaignLayout
  title="Request received — Strong & Sassy | Coach Nikki"
  description="Thanks — Nikki will be in touch to book your foundation assessment."
  conversion={true}
>
  <section class="hero" style="grid-template-columns: 1fr; text-align: center;">
    <div>
      <span class="eyebrow">All done</span>
      <h1 class="display">Got it. Nice one.</h1>
      <p class="lead" style="margin: 0 auto;">
        Thanks for reaching out. Nikki will give you a call or text to book your one-on-one
        foundation assessment and find a time that suits — usually within a business day.
        Once that's done, your first week of Strong &amp; Sassy classes is on her.
      </p>
      <div style="margin-top: 28px;">
        <a class="btn-primary" href="tel:0403122669">Call Nikki: 0403 122 669</a>
        <a class="btn-secondary" href="https://www.instagram.com/coach_nikkir/" target="_blank" rel="noopener noreferrer">See the crew on Instagram</a>
      </div>
    </div>
  </section>
</CampaignLayout>
