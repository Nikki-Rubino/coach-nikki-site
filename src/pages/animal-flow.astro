---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionsArc from '../components/SessionsArc.astro';

const page = await getEntry('pages', 'animal-flow');
const hero = page?.data ?? {
  eyebrow: 'Animal Flow Sydney · Regional Leader',
  heroHeadline: 'Ground based movement. Brain and body.',
  heroSubcopy:
    "Quadrupedal Movement Training that builds strength, range and confidence on the floor. Beginner friendly. Run by Sydney's Animal Flow Regional Leader with ten years on the mats.",
  primaryCtaLabel: 'Book your intro',
  primaryCtaHref: '/get-started',
  secondaryCtaLabel: 'See the timetable',
  secondaryCtaHref: '/timetable',
};

// Pull just the two Animal Flow session types
const afSessions = (await getCollection('sessions', (e) => e.data.tag === 'Animal Flow'))
  .sort((a, b) => a.data.order - b.data.order);

const afFaq = (await getCollection('faqs', (e) => e.id === 'will-i-do-animal-flow'));

// "What it is" body — edit in CMS under Page copy → Animal Flow → Body.
const afBody = page?.rendered?.html ?? '';

// YouTube video ID for the "See it in motion" block. Edit in CMS under Page copy → Animal Flow.
const ytId = page?.data?.youtubeVideoId;
// Optional companion vertical (9:16) clip shown beneath the main landscape video.
const ytVertId = page?.data?.verticalVideoId;

// AF blocks now live inside the page entry.
const whatIs = page?.data?.whatIs;
const waysToTrain = page?.data?.waysToTrain;
const foundations = page?.data?.foundations;
const l1Cert = page?.data?.l1Cert;
const finalCta = page?.data?.finalCta;
---

<BaseLayout
  title={page?.data.seoTitle ?? 'Animal Flow Sydney — Coach Nikki, Regional Leader'}
  description={page?.data.seoDescription}
  activeNav="animal-flow"
>
  <!-- HERO -->
  <section class="af-hero">
    <div class="grid">
      <div>
        <span class="af-badge">{page?.data?.badgeText ?? '★ Sydney Regional Leader · 10 years'}</span>
        <h1>{hero.heroHeadline}</h1>
        <p>{hero.heroSubcopy}</p>
        <div style="margin-top: 28px;">
          <a class="btn-primary" href={hero.primaryCtaHref}>{hero.primaryCtaLabel}</a>
          <a class="btn-secondary" href={hero.secondaryCtaHref}>{hero.secondaryCtaLabel}</a>
        </div>
      </div>
      <div class="ph">
        {hero.heroImage ? (
          <img
            src={hero.heroImage}
            alt={hero.heroHeadline ?? 'Animal Flow'}
            loading="eager"
            fetchpriority="high"
            style="width: 100%; height: 100%; object-fit: cover; display: block;"
          />
        ) : (
          <span class="ph-label">Photo: client in Beast hold, glow lights</span>
        )}
      </div>
    </div>
  </section>

  <!-- WHAT IS AF — section header from src/content/site/af-what-is-section.md, body from src/content/pages/animal-flow.md -->
  <section style="background: #fff;">
    <div class="container">
      <div class="what-youll-do">
        <div>
          {whatIs?.eyebrow && <span class="eyebrow">{whatIs.eyebrow}</span>}
          {whatIs?.heading && <h2 class="section">{whatIs.heading}</h2>}
          <div class="af-body" set:html={afBody} />
        </div>
        <div class="ph">
          {whatIs?.image ? (
            <img
              src={whatIs.image}
              alt="Animal Flow Beast or Crab hold"
              loading="lazy"
              style="width: 100%; height: 100%; object-fit: cover; display: block;"
            />
          ) : (
            <span class="ph-label">Photo: Beast or Crab hold, mid-flow</span>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- VIDEO BLOCK — YouTube embed if youtubeVideoId set in CMS, else placeholder -->
  <section>
    <div class="container narrow">
      <span class="eyebrow">See it in motion</span>
      <h2 class="section">A short flow, from the studio</h2>
      {ytId ? (
        <div class="video-pair">
          <div class="video-embed">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${ytId}?rel=0&modestbranding=1`}
              title="A short flow, from the studio"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          {ytVertId && (
            <div class="video-embed portrait">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${ytVertId}?rel=0&modestbranding=1`}
                title="A vertical flow clip"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          )}
        </div>
      ) : (
        <div class="video-block" style="margin-top: 28px;">
          <div class="play">▶</div>
          <span class="ph-label">Add a YouTube video ID in the CMS (Page copy → 04 Animal Flow → YouTube video ID)</span>
        </div>
      )}
      <p class="muted" style="text-align: center; margin-top: 18px; font-size: 14px;">
        Or check <a href="https://www.instagram.com/coach_nikkir" target="_blank" rel="noopener">@coach_nikkir</a> for weekly clips from the studio.
      </p>
    </div>
  </section>

  <!-- THE TWO SESSIONS — header from src/content/site/af-ways-to-train.md -->
  <section style="background: var(--teal-light);">
    <div class="container">
      {waysToTrain?.eyebrow && <span class="eyebrow">{waysToTrain.eyebrow}</span>}
      {waysToTrain?.heading && <h2 class="section">{waysToTrain.heading}</h2>}
      {waysToTrain?.lead && <p class="lead muted">{waysToTrain.lead}</p>}
      <div class="sessions" style="grid-template-columns: repeat(2, 1fr);">
        {afSessions.map((s) => (
          <article class="session-detail">
            <div class="ph">
              {s.data.image ? (
                <img
                  src={s.data.image}
                  alt={s.data.title}
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover; display: block;"
                />
              ) : (
                <span class="ph-label">{s.data.title}</span>
              )}
            </div>
            <div class="body">
              <span class={`session-chip ${s.data.tagStyle}`}>{s.data.tag}</span>
              <h3>{s.data.title}</h3>
              <p class="summary">{s.data.summary}</p>
              <dl class="meta-rows">
                <div><dt>Capacity</dt><dd>{s.data.capacity}</dd></div>
                <div><dt>Length</dt><dd>{s.data.duration}</dd></div>
                <div><dt>Best for</dt><dd>{s.data.bestFor}</dd></div>
                <div><dt>Price</dt><dd class="price-cell">{s.data.price}</dd></div>
              </dl>
              <div class="session-actions">
                <a class="btn-secondary" href="/timetable">When it's on →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW WE START — shared steps + CTA (Shared content); header per-page from animal-flow.md → foundations -->
  <SessionsArc eyebrow={foundations?.eyebrow} heading={foundations?.heading} lead={foundations?.lead} />

  <!-- L1 / CERT PATH — content from src/content/site/af-l1-cert.md -->
  {l1Cert && (
    <section style="background: #fff;">
      <div class="container narrow">
        {l1Cert.eyebrow && <span class="eyebrow">{l1Cert.eyebrow}</span>}
        {l1Cert.heading && <h2 class="section">{l1Cert.heading}</h2>}
        {l1Cert.lead && <p class="lead">{l1Cert.lead}</p>}
        {l1Cert.closingLine && (
          <p style="margin-top: 18px;">{l1Cert.closingLine}</p>
        )}
        {l1Cert.ctaLabel && (
          <div style="margin-top: 24px;">
            <a class="btn-primary" href={l1Cert.ctaHref ?? '/contact'}>{l1Cert.ctaLabel}</a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- FAQ -->
  {afFaq.length > 0 && (
    <section>
      <div class="container narrow">
        <span class="eyebrow">The honest answer</span>
        <h2 class="section">Will I have to do Animal Flow?</h2>
        <div class="faq">
          {afFaq.map((f) => (
            <details class="faq-item" open>
              <summary>{f.data.question}</summary>
              <div class="faq-body" set:html={f.rendered?.html ?? ''} />
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FINAL CTA — content from src/content/site/af-final-cta.md -->
  {finalCta && (
    <section class="cta-strip">
      <div class="container narrow">
        {finalCta.heading && <h2>{finalCta.heading}</h2>}
        {finalCta.lead && <p>{finalCta.lead}</p>}
        {finalCta.ctaLabel && (
          <a class="btn-primary" href={finalCta.ctaHref ?? '/get-started'}>{finalCta.ctaLabel}</a>
        )}
        {finalCta.ctaSecondaryLabel && (
          <a class="btn-secondary" style="color: #fff !important; border-color: #fff; margin-left: 8px;" href={finalCta.ctaSecondaryHref ?? '/contact'}>
            {finalCta.ctaSecondaryLabel}
          </a>
        )}
      </div>
    </section>
  )}
</BaseLayout>
