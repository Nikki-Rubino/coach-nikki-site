---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionsArc from '../components/SessionsArc.astro';

// Editable hero copy comes from src/content/pages/home.md (via Decap CMS).
const home = await getEntry('pages', 'home');
const hero = home?.data ?? {
  eyebrow: 'Coach Nikki · Matraville, Sydney',
  heroHeadline: 'Strength is ageless.',
  heroSubcopy:
    "I help over-30s through 90s eliminate pain, build confidence, and get strong for life. No mirrors. No grunting. No judgement.",
  primaryCtaLabel: 'Book your intro session',
  primaryCtaHref: '/get-started',
  secondaryCtaLabel: 'See the timetable',
  secondaryCtaHref: '/timetable',
};

// CMS-editable home sections — all nested in pages/home.md.
const doorsBlock = home?.data?.doors;
const promise = home?.data?.promise;
const arc = home?.data?.arc;
const sessionsHeader = home?.data?.sessionsSectionHeader;
const testimonialsHeader = home?.data?.testimonialsHeader;
const blogHeader = home?.data?.blogHeader;
// Yellow FUEL trust strip under the hero — editable in the CMS
// (Page copy → 01 Home → TRUST STRIP).
const trust = home?.data?.trustStrip ?? {};

// Sessions shown on the home page, ordered.
const homeSessions = (await getCollection('sessions', (e) => e.data.showOnHome))
  .sort((a, b) => a.data.order - b.data.order);

// Featured testimonials, ordered.
const featuredTestimonials = (await getCollection('testimonials', (e) => e.data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// Blog posts: CMS-picked (Page copy → 01 Home → SECTION · Blog header →
// Blog posts to feature), falling back to the three most recent published.
const allPosts = (await getCollection('blog', (e) => !e.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const normSlug = (s: string) =>
  s
    .toLowerCase()
    .replace(/\.md$/, '')
    .replace(/^\d{4}-\d{2}-\d{2}-/, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
const pickedPosts = [
  ...new Set(
    (blogHeader?.posts ?? [])
      .map(
        (slug) =>
          allPosts.find((p) => p.id === slug) ??
          allPosts.find(
            (p) => normSlug(p.id) === normSlug(slug) || normSlug(p.data.title) === normSlug(slug),
          ),
      )
      .filter((p) => p !== undefined),
  ),
];
const posts = pickedPosts.length > 0 ? pickedPosts : allPosts.slice(0, 3);

const dateFmt = new Intl.DateTimeFormat('en-AU', { month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Coach Nikki — strength is ageless"
  description="Strength & movement coaching for over 30s in Matraville, Sydney. 1:1 coaching, Sassy Seniors, Animal Flow, semi-private strength."
  activeNav="home"
>
  <!-- HERO -->
  <section class="hero hero-home">
    <div>
      {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
      <h1 class="display">{hero.heroHeadline}</h1>
      <p class="lead">{hero.heroSubcopy}</p>
      <div style="margin-top: 28px;">
        {hero.primaryCtaLabel && (
          <a class="btn-primary" href={hero.primaryCtaHref}>{hero.primaryCtaLabel}</a>
        )}
        {hero.secondaryCtaLabel && (
          <a class="btn-secondary" href={hero.secondaryCtaHref}>{hero.secondaryCtaLabel}</a>
        )}
      </div>
    </div>
    <div class="image">
      {hero.heroImage ? (
        <img
          src={hero.heroImage}
          alt={hero.heroHeadline ?? 'Coach Nikki'}
          loading="eager"
          fetchpriority="high"
          style="width: 100%; height: 100%; object-fit: cover; display: block;"
        />
      ) : (
        <span class="ph-label">Hero photo: studio glow-light vibe with Nikki coaching</span>
      )}
    </div>
  </section>

  <!-- FUEL TRUST STRIP — editable in the CMS (Page copy → 01 Home → TRUST STRIP) -->
  <div class="trust-strip">
    <span class="badge">{trust.badge ?? 'Fuel Woman of the Year 2025'}</span>
    <span class="label">{trust.label ?? 'Recognised for my work with the ageing fitness community.'}</span>
    <a class="link" href={trust.linkHref ?? '/speaking'}>{trust.linkLabel ?? 'Read more →'}</a>
  </div>

  <!-- THREE DOORS — content from pages/home.md → doors -->
  {doorsBlock && doorsBlock.items && (
    <section>
      <div class="container">
        {doorsBlock.eyebrow && <span class="eyebrow">{doorsBlock.eyebrow}</span>}
        {doorsBlock.heading && <h2 class="section">{doorsBlock.heading}</h2>}
        {doorsBlock.lead && <p class="lead muted">{doorsBlock.lead}</p>}
        <div class="doors">
          {doorsBlock.items.map((d) => (
            <a class="door" href={d.href}>
              <div class="ph">
                {d.image ? (
                  <img
                    src={d.image}
                    alt={d.heading}
                    loading="lazy"
                    style="width: 100%; height: 100%; object-fit: cover; display: block;"
                  />
                ) : (
                  <span class="ph-label">{d.imageHint ?? d.heading}</span>
                )}
              </div>
              <div class="body">
                <span class={`tag ${d.tagStyle}`}>{d.tag}</span>
                <h3>{d.heading}</h3>
                <p class="muted" style="font-size:14px; margin-top:8px;">{d.body}</p>
                <span class="arrow">{d.arrowLabel}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- PROMISE — content from pages/home.md → promise -->
  {promise && (
    <section class="promise">
      <div class="container">
        {promise.eyebrow && <span class="eyebrow">{promise.eyebrow}</span>}
        {promise.heading && <h2 class="section">{promise.heading}</h2>}
        {promise.tiles && (
          <div class="tri">
            {promise.tiles.map((t) => (
              <div>
                <div class="word">{t.word}</div>
                <p>{t.body}</p>
              </div>
            ))}
          </div>
        )}
        {promise.pullQuote && (
          <div class="pullquote">
            "{promise.pullQuote}"
            {promise.pullQuoteCite && <cite>{promise.pullQuoteCite}</cite>}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- HOW IT WORKS — shared steps + CTA (Shared content); header per-page from home.md → arc -->
  <SessionsArc eyebrow={arc?.eyebrow} heading={arc?.heading} lead={arc?.lead} />

  <!-- SESSIONS -->
  {homeSessions.length > 0 && (
    <section style="background:#fff;">
      <div class="container">
        <span class="eyebrow">{sessionsHeader?.eyebrow ?? "What's on offer"}</span>
        <h2 class="section">{sessionsHeader?.heading ?? 'Sessions for every body'}</h2>
        <div class="sessions">
          {homeSessions.map((s) => (
            <div class="session-card">
              <div class="ph">
                {s.data.image ? (
                  <img
                    src={s.data.image}
                    alt={s.data.title}
                    loading="lazy"
                    style="width: 100%; height: 100%; object-fit: cover; display: block;"
                  />
                ) : (
                  <span class="ph-label">{s.data.title}</span>
                )}
              </div>
              <h3>{s.data.title}</h3>
              <p>{s.data.summary}</p>
              {s.data.price && <span class="meta">{s.data.price}</span>}
            </div>
          ))}
        </div>
        {sessionsHeader?.caption && (
          <p class="muted" style="margin-top: 24px; text-align:center; font-size: 14px;">
            {sessionsHeader.caption}
          </p>
        )}
      </div>
    </section>
  )}

  <!-- TESTIMONIALS -->
  {featuredTestimonials.length > 0 && (
    <section class="testimonials">
      <div class="container">
        <span class="eyebrow">{testimonialsHeader?.eyebrow ?? 'Words from the dazzle'}</span>
        <h2 class="section">{testimonialsHeader?.heading ?? 'What clients say'}</h2>
        <div class="tlist">
          {featuredTestimonials.map((t) => (
            <div class="testimonial">
              <blockquote>"{t.data.quote}"</blockquote>
              <div class="tperson">
                {t.data.avatar ? (
                  <img src={t.data.avatar} alt={t.data.name} class="avatar" width="44" height="44" />
                ) : (
                  <div class="avatar"></div>
                )}
                <div>
                  <div class="name">{t.data.name}</div>
                  <div class="role">{t.data.role}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- BLOG -->
  {posts.length > 0 && (
    <section>
      <div class="container">
        <span class="eyebrow">{blogHeader?.eyebrow ?? 'From the blog'}</span>
        <h2 class="section">{blogHeader?.heading ?? 'Words on movement'}</h2>
        <div class="blog-list">
          {posts.map((p) => (
            <a class="post" href={`/blog/${p.id}`}>
              <div class="ph">
                {p.data.image ? (
                  <img
                    src={p.data.image}
                    alt={p.data.title}
                    loading="lazy"
                    style="width: 100%; height: 100%; object-fit: cover; display: block;"
                  />
                ) : (
                  <span class="ph-label">Post thumbnail</span>
                )}
              </div>
              <div class="date">{dateFmt.format(p.data.date)}</div>
              <h3>{p.data.title}</h3>
              {p.data.excerpt && <p>{p.data.excerpt}</p>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
