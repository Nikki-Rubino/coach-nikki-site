---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Editable hero copy comes from src/content/pages/home.md (via Decap CMS).
const home = await getEntry('pages', 'home');
const hero = home?.data ?? {
  eyebrow: 'Coach Nikki · Matraville, Sydney',
  heroHeadline: 'Strength is ageless.',
  heroSubcopy:
    "I help over-30s through 90s eliminate pain, build confidence, and get strong for life. No mirrors. No grunting. No judgement.",
  primaryCtaLabel: 'Book your intro session',
  primaryCtaHref: '/get-started',
  secondaryCtaLabel: 'See the timetable',
  secondaryCtaHref: '/timetable',
};

// CMS-editable Home sections.
const doorsBlock = await getEntry('site', 'home-doors');
const promise = await getEntry('site', 'home-promise');
const arc = await getEntry('site', 'home-arc');
const sectionHeaders = await getEntry('site', 'home-section-headers');

// Sessions shown on the home page, ordered.
const homeSessions = (await getCollection('sessions', (e) => e.data.showOnHome))
  .sort((a, b) => a.data.order - b.data.order);

// Featured testimonials, ordered.
const featuredTestimonials = (await getCollection('testimonials', (e) => e.data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// Three most recent blog posts.
const posts = (await getCollection('blog', (e) => !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat('en-AU', { month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Coach Nikki — strength is ageless"
  description="Strength & movement coaching for over 30s in Matraville, Sydney. 1:1 coaching, Sassy Seniors, Animal Flow, semi-private strength."
  activeNav="home"
>
  <!-- HERO -->
  <section class="hero">
    <div>
      {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
      <h1 class="display">{hero.heroHeadline}</h1>
      <p class="lead">{hero.heroSubcopy}</p>
      <div style="margin-top: 28px;">
        {hero.primaryCtaLabel && (
          <a class="btn-primary" href={hero.primaryCtaHref}>{hero.primaryCtaLabel}</a>
        )}
        {hero.secondaryCtaLabel && (
          <a class="btn-secondary" href={hero.secondaryCtaHref}>{hero.secondaryCtaLabel}</a>
        )}
      </div>
    </div>
    <div class="image">
      <span class="ph-label">Hero photo: studio glow-light vibe with Nikki coaching</span>
    </div>
  </section>

  <!-- FUEL TRUST STRIP -->
  <div class="trust-strip">
    <span class="badge">Fuel Woman of the Year 2025</span>
    <span class="label">Recognised for my work with the ageing fitness community.</span>
    <a class="link" href="/speaking">Read the speech →</a>
  </div>

  <!-- THREE DOORS — content from src/content/site/home-doors.md -->
  {doorsBlock && doorsBlock.data.doors && (
    <section>
      <div class="container">
        {doorsBlock.data.eyebrow && <span class="eyebrow">{doorsBlock.data.eyebrow}</span>}
        {doorsBlock.data.heading && <h2 class="section">{doorsBlock.data.heading}</h2>}
        {doorsBlock.data.lead && <p class="lead muted">{doorsBlock.data.lead}</p>}
        <div class="doors">
          {doorsBlock.data.doors.map((d) => (
            <a class="door" href={d.href}>
              <div class="ph"><span class="ph-label">{d.imageHint ?? d.heading}</span></div>
              <div class="body">
                <span class={`tag ${d.tagStyle}`}>{d.tag}</span>
                <h3>{d.heading}</h3>
                <p class="muted" style="font-size:14px; margin-top:8px;">{d.body}</p>
                <span class="arrow">{d.arrowLabel}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- PROMISE — content from src/content/site/home-promise.md -->
  {promise && (
    <section class="promise">
      <div class="container">
        {promise.data.eyebrow && <span class="eyebrow">{promise.data.eyebrow}</span>}
        {promise.data.heading && <h2 class="section">{promise.data.heading}</h2>}
        {promise.data.tiles && (
          <div class="tri">
            {promise.data.tiles.map((t) => (
              <div>
                <div class="word">{t.word}</div>
                <p>{t.body}</p>
              </div>
            ))}
          </div>
        )}
        {promise.data.pullQuote && (
          <div class="pullquote">
            "{promise.data.pullQuote}"
            {promise.data.pullQuoteCite && <cite>{promise.data.pullQuoteCite}</cite>}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- HOW IT WORKS — content from src/content/site/home-arc.md -->
  {arc && (
    <section>
      <div class="container">
        {arc.data.eyebrow && <span class="eyebrow">{arc.data.eyebrow}</span>}
        {arc.data.heading && <h2 class="section">{arc.data.heading}</h2>}
        {arc.data.lead && <p class="lead muted">{arc.data.lead}</p>}
        {arc.data.steps && (
          <div class="steps">
            {arc.data.steps.map((s) => (
              <div class="step">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            ))}
          </div>
        )}
        {arc.data.introCtaHeadline && (
          <div class="intro-cta">
            <div>
              <h3>{arc.data.introCtaHeadline}</h3>
              {arc.data.introCtaSubcopy && <p>{arc.data.introCtaSubcopy}</p>}
            </div>
            {arc.data.introCtaLabel && (
              <a class="btn-primary" href={arc.data.introCtaHref ?? '/get-started'}>
                {arc.data.introCtaLabel}
              </a>
            )}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- SESSIONS -->
  {homeSessions.length > 0 && (
    <section style="background:#fff;">
      <div class="container">
        <span class="eyebrow">{sectionHeaders?.data.eyebrow ?? "What's on offer"}</span>
        <h2 class="section">{sectionHeaders?.data.heading ?? 'Sessions for every body'}</h2>
        <div class="sessions">
          {homeSessions.map((s) => (
            <div class="session-card">
              <div class="ph"><span class="ph-label">{s.data.title}</span></div>
              <h3>{s.data.title}</h3>
              <p>{s.data.summary}</p>
              {s.data.price && <span class="meta">{s.data.price}</span>}
            </div>
          ))}
        </div>
        {sectionHeaders?.data.ctaSubcopy && (
          <p class="muted" style="margin-top: 24px; text-align:center; font-size: 14px;">
            {sectionHeaders.data.ctaSubcopy}
          </p>
        )}
      </div>
    </section>
  )}

  <!-- TESTIMONIALS -->
  {featuredTestimonials.length > 0 && (
    <section class="testimonials">
      <div class="container">
        <span class="eyebrow">{sectionHeaders?.data.bannerHeadline ?? 'Words from the dazzle'}</span>
        <h2 class="section">{sectionHeaders?.data.subHeading ?? 'What clients say'}</h2>
        <div class="tlist">
          {featuredTestimonials.map((t) => (
            <div class="testimonial">
              <blockquote>"{t.data.quote}"</blockquote>
              <div class="tperson">
                {t.data.avatar ? (
                  <img src={t.data.avatar} alt={t.data.name} class="avatar" width="44" height="44" />
                ) : (
                  <div class="avatar"></div>
                )}
                <div>
                  <div class="name">{t.data.name}</div>
                  <div class="role">{t.data.role}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- BLOG -->
  {posts.length > 0 && (
    <section>
      <div class="container">
        <span class="eyebrow">{sectionHeaders?.data.bannerSubcopy ?? 'From the blog'}</span>
        <h2 class="section">{sectionHeaders?.data.ctaLabel ?? 'Words on movement'}</h2>
        <div class="blog-list">
          {posts.map((p) => (
            <a class="post" href={`/blog/${p.id}`}>
              <div class="ph"><span class="ph-label">Post thumbnail</span></div>
              <div class="date">{dateFmt.format(p.data.date)}</div>
              <h3>{p.data.title}</h3>
              {p.data.excerpt && <p>{p.data.excerpt}</p>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
