---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'pricing');
const hero = page?.data ?? {
  eyebrow: 'Simple, honest pricing',
  heroHeadline: "One rate per session. One rate for the week. That's it.",
  heroSubcopy:
    'Whichever session you choose, the price is the same. Weekly unlimited covers three to four sessions a week across any combination.',
  primaryCtaLabel: 'Book your intro',
  primaryCtaHref: '/get-started',
  secondaryCtaLabel: 'Have a question',
  secondaryCtaHref: '/contact',
};

// Pricing blocks now live inside the page entry.
const tiersBlock = page?.data?.tiers;
const weekly = page?.data?.weeklyUnpacked;
const policy = page?.data?.policy;
const finalCta = page?.data?.finalCta;

const pricingFaqs = (await getCollection('faqs', (e) => e.data.category === 'Pricing'))
  .sort((a, b) => a.data.order - b.data.order);

const cancelFaqs = (await getCollection('faqs', (e) => e.data.category === 'Cancellations'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={page?.data.seoTitle ?? 'Pricing — Coach Nikki Matraville'}
  description={page?.data.seoDescription}
  activeNav="pricing"
>
  <!-- HERO -->
  <section class="hero">
    <div>
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1 class="display">{hero.heroHeadline}</h1>
      <p class="lead">{hero.heroSubcopy}</p>
      <div style="margin-top: 28px;">
        <a class="btn-primary" href={hero.primaryCtaHref}>{hero.primaryCtaLabel}</a>
        <a class="btn-secondary" href={hero.secondaryCtaHref}>{hero.secondaryCtaLabel}</a>
      </div>
    </div>
    <div class="image">
      <span class="ph-label">Photo: studio detail or client smiling mid-session</span>
    </div>
  </section>

  <!-- PRICING TIERS — content from src/content/site/pricing-tiers.md -->
  {tiersBlock && tiersBlock.items && (
    <section style="background: #fff;">
      <div class="container">
        {tiersBlock.eyebrow && <span class="eyebrow">{tiersBlock.eyebrow}</span>}
        {tiersBlock.heading && <h2 class="section">{tiersBlock.heading}</h2>}
        <div class="pricing-grid">
          {tiersBlock.items.map((t) => (
            <div class={`price${t.featured ? ' featured' : ''}`}>
              <h3>{t.label}</h3>
              <div class="amount">{t.amount} {t.amountNote && <small>{t.amountNote}</small>}</div>
              {t.desc && <p class="desc">{t.desc}</p>}
              {t.bullets && t.bullets.length > 0 && (
                <ul>
                  {t.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
              {t.ctaLabel && (
                <a
                  class={t.featured ? 'btn-primary' : 'btn-secondary'}
                  href={t.ctaHref ?? '/get-started'}
                  style={t.featured ? 'margin-top: 12px;' : ''}
                >
                  {t.ctaLabel}
                </a>
              )}
            </div>
          ))}
        </div>
        {tiersBlock.closingLine && (
          <p class="price-note">{tiersBlock.closingLine}</p>
        )}
      </div>
    </section>
  )}

  <!-- WEEKLY UNLIMITED UNPACKED — content from src/content/site/pricing-weekly-unpacked.md -->
  {weekly && (
    <section>
      <div class="container">
        {weekly.eyebrow && <span class="eyebrow">{weekly.eyebrow}</span>}
        {weekly.heading && <h2 class="section">{weekly.heading}</h2>}
        {weekly.lead && <p class="lead muted">{weekly.lead}</p>}
        {weekly.capacityGrid && (
          <div class="format-grid">
            {weekly.capacityGrid.map((c) => (
              <div class="format-card">
                <div class="num">{c.number}</div>
                <div class="lbl">{c.label}</div>
              </div>
            ))}
          </div>
        )}
        {weekly.capacityCaption && (
          <p class="muted" style="margin-top: 24px; text-align: center; font-size: 14px;">
            {weekly.capacityCaption}
          </p>
        )}
      </div>
    </section>
  )}

  <!-- CANCELLATION POLICY — content from src/content/site/pricing-policy.md -->
  {policy && (
    <section style="background: var(--teal-light);">
      <div class="container narrow">
        {policy.eyebrow && <span class="eyebrow">{policy.eyebrow}</span>}
        {policy.heading && <h2 class="section">{policy.heading}</h2>}
        {policy.lead && <p class="lead">{policy.lead}</p>}
        {policy.items && (
          <div class="policy-rows">
            {policy.items.map((p) => (
              <div class="policy-row">
                <div class="policy-h">{p.heading}</div>
                <ul>
                  {p.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- FAQS -->
  {(pricingFaqs.length > 0 || cancelFaqs.length > 0) && (
    <section style="background: #fff;">
      <div class="container narrow">
        <span class="eyebrow">The detail</span>
        <h2 class="section">Pricing questions</h2>
        <div class="faq">
          {pricingFaqs.map((f) => (
            <details class="faq-item">
              <summary>{f.data.question}</summary>
              <div class="faq-body" set:html={f.rendered?.html ?? ''} />
            </details>
          ))}
          {cancelFaqs.map((f) => (
            <details class="faq-item">
              <summary>{f.data.question}</summary>
              <div class="faq-body" set:html={f.rendered?.html ?? ''} />
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA — content from src/content/site/pricing-cta.md -->
  {finalCta && (
    <section class="cta-strip">
      <div class="container narrow">
        {finalCta.heading && <h2>{finalCta.heading}</h2>}
        {finalCta.lead && <p>{finalCta.lead}</p>}
        {finalCta.ctaLabel && (
          <a class="btn-primary" href={finalCta.ctaHref ?? '/get-started'}>
            {finalCta.ctaLabel}
          </a>
        )}
        {finalCta.ctaSecondaryLabel && (
          <a
            class="btn-secondary"
            style="color: #fff !important; border-color: #fff; margin-left: 8px;"
            href={finalCta.ctaSecondaryHref ?? '/contact'}
          >
            {finalCta.ctaSecondaryLabel}
          </a>
        )}
      </div>
    </section>
  )}
</BaseLayout>
