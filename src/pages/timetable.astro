---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'timetable');
const hero = page?.data ?? {
  eyebrow: "What's on this week",
  heroHeadline: 'The weekly timetable',
  heroSubcopy:
    'All sessions, all capacities. Have a look around. New clients start with a three-session intro before joining any group.',
};

// Static schedule image + intro note. Edit both in the CMS:
// Page copy → 05 Timetable → Schedule image / Schedule note.
const scheduleImage = page?.data?.scheduleImage;
const scheduleNote = page?.data?.scheduleNote;
---

<BaseLayout
  title="Timetable — Coach Nikki, Matraville Sydney"
  description="Weekly session timetable for Coach Nikki's Matraville studio. Sassy Seniors, semi-private strength, Animal Flow, Breath & Mobility."
  activeNav="timetable"
>
  <!-- HERO -->
  <section class="timetable-hero">
    <div class="container">
      <div>
        <span class="eyebrow">{hero.eyebrow}</span>
        <h1 class="display">{hero.heroHeadline}</h1>
        <p class="lead">{hero.heroSubcopy}</p>
      </div>
    </div>
  </section>

  <!-- STATIC SCHEDULE IMAGE — Page copy → 05 Timetable → Schedule image -->
  <section style="background: #fff;">
    <div class="container">
      {scheduleImage ? (
        <img
          src={scheduleImage}
          alt="Coach Nikki weekly semi-private timetable"
          loading="eager"
          style="width: 100%; height: auto; display: block; border-radius: 14px;"
        />
      ) : (
        <div class="video-block" style="aspect-ratio: 16/9;">
          <span class="ph-label">Add the timetable image in the CMS (Page copy → 05 Timetable → Schedule image)</span>
        </div>
      )}

      {scheduleNote && (
        <p class="tt-note">{scheduleNote}</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .tt-note {
    max-width: 720px;
    margin: 28px auto 0;
    text-align: center;
    font-size: 18px;
    line-height: 1.6;
    background: var(--teal-light);
    border-radius: 14px;
    padding: 22px 26px;
  }
</style>
