---
import { getEntry } from 'astro:content';
import CampaignLayout from '../layouts/CampaignLayout.astro';

// Reuse imagery + badge already managed in the CMS for the main Animal Flow page.
const af = await getEntry('pages', 'animal-flow');
const heroImage = af?.data?.heroImage;
const badgeText = af?.data?.badgeText ?? '★ Animal Flow Sydney Regional Leader · coaching since 2016';
const whatIsImage = af?.data?.whatIs?.image;
---

<CampaignLayout
  title="Animal Flow Skills — two classes for the price of one | Coach Nikki Sydney"
  description="Try Animal Flow's beginner Skills classes buy-one-get-one-free: both sessions this week for $55 instead of $110. Led by an Animal Flow Sydney Regional Leader in Matraville."
  ogImage={heroImage}
>
  <!-- HERO -->
  <section class="hero">
    <div>
      <span class="eyebrow">Animal Flow® Sydney · Regional Leader</span>
      <h1 class="display">Try Animal Flow Skills — two classes for the price of one.</h1>
      <p class="lead">
        Ground-based movement that builds strength, mobility and control you didn't know you were missing.
        Come try our beginner Skills classes: book one this week and your second is on us.
        No equipment, no mirrors — just you, the floor and the music.
      </p>
      <div style="margin-top: 28px;">
        <a class="btn-primary" href="#book">Claim my 2-for-1 week</a>
      </div>
      <p class="af-badge" style="margin-top: 22px; display: inline-block;">{badgeText}</p>
    </div>
    <div class="image">
      {heroImage ? (
        <img src={heroImage} alt="Animal Flow with Coach Nikki" loading="eager" fetchpriority="high" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
      ) : (
        <span class="ph-label">Photo: Nikki mid-flow on the floor</span>
      )}
    </div>
  </section>

  <!-- OFFER, SAID PLAINLY -->
  <section class="cta-strip">
    <div class="container narrow">
      <h2>Buy one Skills class, get one free.</h2>
      <p>Try both beginner Skills sessions this week — Saturday 10am and Tuesday 6:15pm — for the price of one. That's the full week for $55 instead of $110.</p>
      <a class="btn-primary" href="#book">Claim my 2-for-1 week</a>
    </div>
  </section>

  <!-- WHAT IT IS -->
  <section style="background:#fff;">
    <div class="container">
      <div class="what-youll-do">
        <div class="ph">
          {whatIsImage ? (
            <img src={whatIsImage} alt="Animal Flow ground-based movement" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
          ) : (
            <span class="ph-label">Photo: a clean Animal Flow shape</span>
          )}
        </div>
        <div>
          <span class="eyebrow">What it is</span>
          <h2 class="section">Strength, range and brain — all on the floor.</h2>
          <p class="lead">A ground-based bodyweight system that rebuilds the connection between your brain, body and nervous system. It exposes your limits, then quietly helps fix them.</p>
          <ul>
            <li>Brilliant companion to strength training</li>
            <li>Builds joint resilience for hips, shoulders, wrists and spine</li>
            <li>Develops coordination, balance and proprioception</li>
            <li>Scales from total beginner to certified instructor</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT THE TRIAL COVERS -->
  <section>
    <div class="container">
      <span class="eyebrow">What your 2-for-1 covers</span>
      <h2 class="section">Both Skills classes — the beginner front door.</h2>
      <p class="lead" style="max-width: 760px;">
        Skills is where you learn each shape clean, so it's the perfect place to start. Your 2-for-1 week
        gets you into both Skills sessions. Build a Flow — where you string the shapes together — is waiting
        for you once you've got the basics.
      </p>
      <div class="format-grid" style="margin-top: 32px;">
        <div class="format-card"><div class="num">Sat</div><div class="lbl">10:00am Skills</div></div>
        <div class="format-card"><div class="num">Tue</div><div class="lbl">6:15pm Skills</div></div>
        <div class="format-card"><div class="num">8</div><div class="lbl">Maximum per session</div></div>
        <div class="format-card"><div class="num">$55</div><div class="lbl">Both Skills classes (normally $110)</div></div>
      </div>
    </div>
  </section>

  <!-- PRACTICAL DETAILS -->
  <section style="background:#fff;">
    <div class="container">
      <span class="eyebrow">When and where</span>
      <h2 class="section">The practical bit</h2>
      <p class="lead" style="max-width: 760px;">
        At the Matraville studio — Unit 3 / 60 Perry St. No equipment needed. Bring water and comfy gear —
        we train barefoot. Your 2-for-1 covers the two Skills classes; Build a Flow also runs Saturday 9:15am
        and Tuesday 5:15pm when you're ready for it.
      </p>
    </div>
  </section>

  <!-- SHORT FAQ -->
  <section>
    <div class="container narrow">
      <span class="eyebrow">A few quick questions</span>
      <h2 class="section">Honest answers</h2>
      <div class="faq">
        <details class="faq-item"><summary>What's included in the 2-for-1?</summary><div class="faq-body"><p>Both beginner Skills classes this week — Saturday 10am and Tuesday 6:15pm — for $55, normally $110.</p></div></details>
        <details class="faq-item"><summary>I've never done it before — is that ok?</summary><div class="faq-body"><p>Perfect. Skills is built for exactly that — we teach you each shape from scratch.</p></div></details>
        <details class="faq-item"><summary>Do I need to be strong or flexible already?</summary><div class="faq-body"><p>No. Animal Flow builds both — that's the whole point.</p></div></details>
        <details class="faq-item"><summary>What happens after the trial?</summary><div class="faq-body"><p>If you love it, Skills is $55 a session or part of a weekly membership. Nikki will walk you through the options — no pressure.</p></div></details>
      </div>
    </div>
  </section>

  <!-- FINAL CTA + FORM -->
  <section id="book" style="background: var(--teal-light);">
    <div class="container narrow">
      <h2 class="section">Claim your 2-for-1 Skills week.</h2>
      <p class="lead">Drop your details in and Nikki will be in touch to lock in your two Skills classes and sort the rest.</p>

      <form
        id="af-form-el"
        name="animal-flow-skills-trial"
        method="POST"
        netlify
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/AF-thanks/"
        class="contact-form"
        style="margin-top: 32px;"
      >
        <input type="hidden" name="form-name" value="animal-flow-skills-trial" />
        <p class="hidden-field"><label>Don't fill this out: <input name="bot-field" /></label></p>

        <label class="field">
          <span>Your name</span>
          <input type="text" name="name" required />
        </label>

        <label class="field">
          <span>Email</span>
          <input type="email" name="email" required />
        </label>

        <label class="field">
          <span>Phone</span>
          <input type="tel" name="phone" required />
        </label>

        <fieldset class="field">
          <legend>Which Skills class do you want to start with?</legend>
          <div class="radio-row">
            <label class="radio"><input type="radio" name="session" value="sat-skills" /> Sat 10:00am</label>
            <label class="radio"><input type="radio" name="session" value="tue-skills" /> Tue 6:15pm</label>
            <label class="radio"><input type="radio" name="session" value="either" checked /> Either / not sure</label>
          </div>
        </fieldset>

        <fieldset class="field">
          <legend>New to Animal Flow?</legend>
          <div class="radio-row">
            <label class="radio"><input type="radio" name="experience" value="new" checked /> Yes, brand new</label>
            <label class="radio"><input type="radio" name="experience" value="some" /> Done a bit before</label>
          </div>
        </fieldset>

        <button type="submit" class="btn-primary" style="margin-top: 8px;">Claim my 2-for-1 week</button>
      </form>
    </div>
  </section>

  <!-- JS submit → our own thanks page. -->
  <script is:inline>
    (function () {
      const form = document.getElementById('af-form-el');
      if (!form) return;
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
        const data = new FormData(form);
        const params = new URLSearchParams();
        for (const [k, v] of data.entries()) params.append(k, v);
        try {
          await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString() });
        } catch (_) {}
        window.location.href = '/AF-thanks/';
      });
    })();
  </script>
</CampaignLayout>
